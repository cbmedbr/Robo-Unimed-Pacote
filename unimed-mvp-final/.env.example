# Credenciais do portal Unimed SC
UNIMED_USUARIO=300788
UNIMED_SENHA=trocar_aqui

# URL do portal
UNIMED_URL=https://rda.unimedsc.com.br/cmagnet/Login.do

# Configurações do robô
HEADLESS=false
SCREENSHOT_DIR=./screenshots
LOG_LEVEL=info
DEBUG=false

# Timeouts (ms)
NAVEGACAO_TIMEOUT=30000
CLICK_TIMEOUT=10000

# ---------------------------------------------------------------------------
# SC Saude — DESLIGADO por padrao
#
# O robo de SC Saude ainda esta em teste numa maquina so. O codigo chega em
# todas pelo git pull, mas so opera onde esta variavel estiver como true.
# Deixe ausente ou false em qualquer maquina que nao seja a de teste.
# ---------------------------------------------------------------------------
# SCSAUDE_HABILITADO=true
# SCSAUDE_USUARIO=
#
# ATENCAO: a senha do SC Saude contem "#", e o dotenv le isso como inicio de
# comentario. SEM ASPAS o valor chega truncado e o portal responde apenas
# "usuario e/ou senha invalidos", sem nada apontando para este arquivo.
# SCSAUDE_SENHA="coloque entre aspas"
